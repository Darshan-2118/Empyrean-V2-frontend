# Backend URL for Vite dev server proxy
# The frontend uses relative URLs (/api, /health), so the backend
# address stays server-side in the Vite proxy — never exposed to the browser.
VITE_BACKEND_URL=http://localhost:8000

# Base URL of the REST API (see docs/frontend-integration.md §2).
# Every fetch builds off this. In production point it at your domain:
# e.g. https://your-domain/api/v1
VITE_API_BASE_URL=http://localhost:8000/api/v1

# (Planned — Phase 9) WebSocket broadcast endpoint for live air alerts.
VITE_WS_URL=ws://localhost:8000/ws/alerts